# Desarrollo local. En producción: NODE_ENV=production y origen HTTPS público.
NODE_ENV=development
PORT=3001
SERVER_URL=http://localhost:3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kyc_whatsapp
DB_USER=kyc_bot
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# Generar secretos independientes: openssl rand -hex 32
# Conservar DATA_ENCRYPTION_KEY junto al respaldo de configuración.
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
REPORT_SIGNING_KEY=
HISTORY_RETENTION_DAYS=90

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+5215500000000
KYC_API_URL=https://listas.example.com/api/listas
KYC_API_KEY=
KYC_VALIDATION_API_URL=https://validacion.example.com/api
KYC_VALIDATION_API_KEY=
# Opcional: diagnóstico GET que no ejecute búsquedas ni consuma consultas.
KYC_HEALTH_URL=

# Solo importa al primer propietario durante npm run migrate.
# Retirar ADMIN_PASS después de validar acceso y cambiar contraseña.
ADMIN_USER=
ADMIN_PASS=

# Pruebas: configurar en .env.test.local; solo permiten MySQL local.
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3306
# TEST_DB_USER=root
# TEST_DB_PASSWORD=
